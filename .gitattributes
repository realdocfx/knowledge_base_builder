# Deterministic, reproducible line endings (audit P1).
# Without this the working tree re-dirties on every checkout under a different
# core.autocrlf, making `git diff` unreviewable and the signed baseline
# unreproducible (NIST SP 800-53 CM-3/CM-6).

# Default: git decides text vs binary; text is stored LF and checked out LF.
* text=auto eol=lf

# Windows launchers are parsed by cmd.exe / PowerShell and MUST keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Explicit binaries (text=auto already detects these; belt-and-braces).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.whl  binary
*.img  binary
*.efi  binary
*.gz   binary
*.xz   binary
*.zip  binary
*.woff binary
*.woff2 binary
